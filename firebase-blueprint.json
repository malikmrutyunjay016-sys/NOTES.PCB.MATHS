{
  "entities": {
    "Course": {
      "title": "Course",
      "description": "Academic course or paper section containing syllabus, units, and books",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string", "maxLength": 50 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "department": { "type": "string", "maxLength": 100 },
        "semester": { "type": "string", "maxLength": 50 },
        "syllabusText": { "type": "string", "maxLength": 50000 },
        "answerFormat": { "type": "string", "maxLength": 100 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "title", "createdBy", "createdAt"]
    },
    "Unit": {
      "title": "Unit",
      "description": "Syllabus unit with notes generated from reference books",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string", "maxLength": 128 },
        "unitNumber": { "type": "integer" },
        "title": { "type": "string", "maxLength": 200 },
        "topics": { "type": "string", "maxLength": 5000 },
        "notes": { "type": "string", "maxLength": 100000 },
        "summary": { "type": "string", "maxLength": 5000 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["courseId", "unitNumber", "title", "createdBy", "createdAt"]
    },
    "Book": {
      "title": "Book",
      "description": "Reference book uploaded to library for a course or general reference",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "author": { "type": "string", "maxLength": 200 },
        "edition": { "type": "string", "maxLength": 100 },
        "fileName": { "type": "string", "maxLength": 255 },
        "fileSize": { "type": "integer" },
        "content": { "type": "string", "maxLength": 200000 },
        "fileData": { "type": "string", "maxLength": 750000 },
        "fileChunkCount": { "type": "integer" },
        "mimeType": { "type": "string", "maxLength": 100 },
        "excerpt": { "type": "string", "maxLength": 5000 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["courseId", "title", "content", "createdBy", "createdAt"]
    },
    "Question": {
      "title": "Question",
      "description": "Curated or user asked question with summarized reference book answer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string", "maxLength": 128 },
        "unitId": { "type": "string", "maxLength": 128 },
        "question": { "type": "string", "maxLength": 2000 },
        "answer": { "type": "string", "maxLength": 50000 },
        "marks": { "type": "number" },
        "section": { "type": "string", "maxLength": 50 },
        "answerFormat": { "type": "string", "maxLength": 100 },
        "isCurated": { "type": "boolean" },
        "thinkingUsed": { "type": "boolean" },
        "groundedInSearch": { "type": "boolean" },
        "modelUsed": { "type": "string", "maxLength": 100 },
        "sourceBooks": { "type": "string", "maxLength": 1000 },
        "webSources": { "type": "array" },
        "pdfDataUrl": { "type": "string", "maxLength": 750000 },
        "pdfChunkCount": { "type": "integer" },
        "pdfFileName": { "type": "string", "maxLength": 255 },
        "mimeType": { "type": "string", "maxLength": 100 },
        "askedBy": { "type": "string", "maxLength": 128 },
        "askedByName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["courseId", "question", "answer", "askedBy", "createdAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized administrator document",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "WordNote": {
      "title": "WordNote",
      "description": "Microsoft Word document edited by admin and auto-converted to PDF for users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string", "maxLength": 128 },
        "unitId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "subject": { "type": "string", "maxLength": 200 },
        "author": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 100 },
        "keywords": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "maxLength": 50 },
        "comments": { "type": "string", "maxLength": 2000 },
        "htmlContent": { "type": "string", "maxLength": 300000 },
        "plainText": { "type": "string", "maxLength": 200000 },
        "pageSettingsJson": { "type": "string", "maxLength": 5000 },
        "pdfDataUrl": { "type": "string", "maxLength": 800000 },
        "pdfChunkCount": { "type": "integer" },
        "pdfFileName": { "type": "string", "maxLength": 255 },
        "wordCount": { "type": "number" },
        "charCount": { "type": "number" },
        "pageCount": { "type": "number" },
        "version": { "type": "number" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["courseId", "title", "htmlContent", "pdfDataUrl", "createdBy", "createdAt"]
    },
    "PdfChunk": {
      "title": "PdfChunk",
      "description": "Ordered base64 data-URL chunk for large PDF attachments",
      "type": "object",
      "properties": {
        "index": { "type": "integer" },
        "data": { "type": "string", "maxLength": 750000 },
        "createdBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["index", "data", "createdBy"]
    }
  },
  "firestore": {
    "/courses/{courseId}": {
      "schema": { "$ref": "Course" },
      "description": "Academic courses and paper sections"
    },
    "/units/{unitId}": {
      "schema": { "$ref": "Unit" },
      "description": "Syllabus unit breakdown with notes"
    },
    "/books/{bookId}": {
      "schema": { "$ref": "Book" },
      "description": "Reference books uploaded to the system"
    },
    "/books/{bookId}/chunks/{chunkId}": {
      "schema": { "$ref": "PdfChunk" },
      "description": "Ordered binary data-URL chunks for large reference book PDFs"
    },
    "/questions/{questionId}": {
      "schema": { "$ref": "Question" },
      "description": "Questions and reference-based answers"
    },
    "/questions/{questionId}/chunks/{chunkId}": {
      "schema": { "$ref": "PdfChunk" },
      "description": "Ordered binary data-URL chunks for large question PDFs"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "Admin" },
      "description": "Verified admin users"
    },
    "/word_notes/{noteId}": {
      "schema": { "$ref": "WordNote" },
      "description": "Admin Word documents auto-converted to PDF for student reading"
    },
    "/word_notes/{noteId}/chunks/{chunkId}": {
      "schema": { "$ref": "PdfChunk" },
      "description": "Ordered binary data-URL chunks for large WordNote PDFs"
    }
  }
}
