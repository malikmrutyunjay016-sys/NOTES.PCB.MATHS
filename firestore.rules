rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection validation test document
    match /test/connection {
      allow get: if true;
    }

    // Primitive helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'malikmrutyunjay016@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validators
    function isValidCourse(data) {
      return data.keys().hasAll(['code', 'title', 'createdBy', 'createdAt']) &&
        data.keys().hasOnly(['id', 'code', 'title', 'description', 'department', 'semester', 'syllabusText', 'answerFormat', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.code is string && data.code.size() > 0 && data.code.size() <= 50 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
        (!('department' in data) || (data.department is string && data.department.size() <= 100)) &&
        (!('semester' in data) || (data.semester is string && data.semester.size() <= 50)) &&
        (!('syllabusText' in data) || (data.syllabusText is string && data.syllabusText.size() <= 50000)) &&
        (!('answerFormat' in data) || (data.answerFormat is string && data.answerFormat.size() <= 100)) &&
        data.createdBy is string && data.createdBy.size() <= 128;
    }

    function isValidUnit(data) {
      return data.keys().hasAll(['courseId', 'unitNumber', 'title', 'createdBy', 'createdAt']) &&
        data.keys().hasOnly(['id', 'courseId', 'unitNumber', 'title', 'topics', 'notes', 'summary', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.courseId is string && data.courseId.size() > 0 && data.courseId.size() <= 128 &&
        data.unitNumber is int &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        (!('topics' in data) || (data.topics is string && data.topics.size() <= 5000)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 100000)) &&
        (!('summary' in data) || (data.summary is string && data.summary.size() <= 5000)) &&
        data.createdBy is string && data.createdBy.size() <= 128;
    }

    function isValidBook(data) {
      return data.keys().hasAll(['courseId', 'title', 'content', 'createdBy', 'createdAt']) &&
        data.keys().hasOnly(['id', 'courseId', 'title', 'author', 'edition', 'fileName', 'fileSize', 'content', 'fileData', 'mimeType', 'excerpt', 'createdBy', 'createdAt']) &&
        data.courseId is string && data.courseId.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        (!('author' in data) || (data.author is string && data.author.size() <= 200)) &&
        (!('edition' in data) || (data.edition is string && data.edition.size() <= 100)) &&
        (!('fileName' in data) || (data.fileName is string && data.fileName.size() <= 255)) &&
        (!('fileSize' in data) || (data.fileSize is number)) &&
        data.content is string && data.content.size() > 0 && data.content.size() <= 1000000 &&
        (!('fileData' in data) || (data.fileData is string && data.fileData.size() <= 2000000)) &&
        (!('mimeType' in data) || (data.mimeType is string && data.mimeType.size() <= 100)) &&
        (!('excerpt' in data) || (data.excerpt is string && data.excerpt.size() <= 5000)) &&
        data.createdBy is string && data.createdBy.size() <= 128;
    }

    function isValidQuestion(data) {
      return data.keys().hasAll(['courseId', 'question', 'answer', 'askedBy', 'createdAt']) &&
        data.keys().hasOnly(['id', 'courseId', 'unitId', 'question', 'answer', 'answerFormat', 'isCurated', 'thinkingUsed', 'groundedInSearch', 'modelUsed', 'sourceBooks', 'askedBy', 'askedByName', 'createdAt', 'updatedAt']) &&
        data.courseId is string && data.courseId.size() <= 128 &&
        (!('unitId' in data) || (data.unitId is string && data.unitId.size() <= 128)) &&
        data.question is string && data.question.size() > 0 && data.question.size() <= 2000 &&
        data.answer is string && data.answer.size() > 0 && data.answer.size() <= 50000 &&
        (!('answerFormat' in data) || (data.answerFormat is string && data.answerFormat.size() <= 100)) &&
        (!('isCurated' in data) || (data.isCurated is bool)) &&
        (!('thinkingUsed' in data) || (data.thinkingUsed is bool)) &&
        (!('groundedInSearch' in data) || (data.groundedInSearch is bool)) &&
        (!('modelUsed' in data) || (data.modelUsed is string && data.modelUsed.size() <= 50)) &&
        (!('sourceBooks' in data) || (data.sourceBooks is string && data.sourceBooks.size() <= 1000)) &&
        data.askedBy is string && data.askedBy.size() <= 128 &&
        (!('askedByName' in data) || (data.askedByName is string && data.askedByName.size() <= 100));
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['email', 'role']) &&
        data.keys().hasOnly(['email', 'role', 'createdAt']) &&
        data.email is string && data.email.size() <= 150 &&
        data.role is string && data.role.size() <= 50;
    }

    // Courses collection
    match /courses/{courseId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(courseId) && (isAdmin() || incoming().createdBy == request.auth.uid) && isValidCourse(incoming());
      allow update: if isSignedIn() && isValidId(courseId) && (isAdmin() || existing().createdBy == request.auth.uid) && isValidCourse(incoming()) &&
        (incoming().createdBy == existing().createdBy || isAdmin());
      allow delete: if isSignedIn() && isValidId(courseId) && (isAdmin() || existing().createdBy == request.auth.uid);
    }

    // Units collection
    match /units/{unitId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(unitId) && (isAdmin() || incoming().createdBy == request.auth.uid) && isValidUnit(incoming());
      allow update: if isSignedIn() && isValidId(unitId) && (isAdmin() || existing().createdBy == request.auth.uid) && isValidUnit(incoming()) &&
        (incoming().createdBy == existing().createdBy || isAdmin()) &&
        incoming().courseId == existing().courseId;
      allow delete: if isSignedIn() && isValidId(unitId) && (isAdmin() || existing().createdBy == request.auth.uid);
    }

    // Books collection
    match /books/{bookId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(bookId) && (isAdmin() || incoming().createdBy == request.auth.uid) && isValidBook(incoming());
      allow update: if isSignedIn() && isValidId(bookId) && (isAdmin() || existing().createdBy == request.auth.uid) && isValidBook(incoming()) &&
        (incoming().createdBy == existing().createdBy || isAdmin()) &&
        incoming().courseId == existing().courseId;
      allow delete: if isSignedIn() && isValidId(bookId) && (isAdmin() || existing().createdBy == request.auth.uid);
    }

    // Questions collection
    match /questions/{questionId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(questionId) && isValidQuestion(incoming());
      allow update: if isSignedIn() && isValidId(questionId) && isValidQuestion(incoming()) &&
        (isAdmin() || existing().askedBy == request.auth.uid) &&
        (incoming().askedBy == existing().askedBy || isAdmin()) &&
        incoming().courseId == existing().courseId;
      allow delete: if isSignedIn() && isValidId(questionId) && (isAdmin() || existing().askedBy == request.auth.uid);
    }

    // Admins collection
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(adminId) && isValidAdmin(incoming());
    }
  }
}
